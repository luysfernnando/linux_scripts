[user]
	email = luysfernnando@gmail.com
	name = Luys Fernnando
	signingKey = ~/.ssh/luysfernnando_sign_commits.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgSign = true
[tag]
	forceSignAnnotated = true
[core]
	editor = code --wait
	autocrlf = input
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
# `gh` sem path absoluto: resolve via PATH em qualquer SO. `gh auth setup-git`
# escreve /usr/bin/gh hardcoded, que no Windows falha em todo push
# ("/usr/bin/gh: No such file or directory"). Sem os `helper =` vazios que ele
# também escreve, o helper nativo do gitconfig do sistema (`manager` no
# Windows) fica como fallback pra quando o gh não estiver instalado.
[credential]
	helper = !gh auth git-credential
