{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "@LOGO_PATH@",
    "type": "@LOGO_TYPE@",
    "width": @LOGO_W@,
    "height": @LOGO_H@,
    "padding": {
      "top": 1
    }
  },
  "display": {
    "color": {
      "title": "1;38;2;100;210;255"
    },
    "percent": {
      "color": {
        "green": "1;38;2;100;210;255",
        "yellow": "1;38;2;190;90;255",
        "red": "1;38;2;255;60;120"
      }
    },
    "key": {
      "type": "string"
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "@OS_ICON@ OS", "keyColor": "1;38;2;100;210;255" },
    { "type": "kernel", "key": "󰘚 Kernel", "keyColor": "1;38;2;111;196;255" },
    { "type": "uptime", "key": "󰅐 Uptime", "keyColor": "1;38;2;116;189;255" },
    { "type": "packages", "key": "󰏖 Packages", "keyColor": "1;38;2;121;182;255" },
    "break",
    { "type": "shell", "key": "󰆍 Shell", "keyColor": "1;38;2;126;175;255" },
    { "type": "terminal", "key": "󰞷 Terminal", "keyColor": "1;38;2;132;168;255" },
    { "type": "de", "key": "󰇅 DE", "keyColor": "1;38;2;137;161;255" },
    { "type": "wm", "key": "󰖲 WM", "keyColor": "1;38;2;142;154;255" },
    { "type": "theme", "key": "󰏘 Theme", "keyColor": "1;38;2;148;146;255" },
    "break",
    { "type": "cpu", "key": "󰻠 CPU", "format": "{name}", "keyColor": "1;38;2;153;139;255" },
    { "type": "gpu", "key": "󰢮 GPU", "format": "{name}", "keyColor": "1;38;2;158;132;255" },
    { "type": "memory", "key": "󰍛 Memory", "keyColor": "1;38;2;164;125;255" },
    { "type": "swap", "key": "󰓡 Swap", "keyColor": "1;38;2;169;118;255" },
    "break",
    { "type": "localip", "key": "󰩠 Local IP", "keyColor": "1;38;2;179;104;255" },
    { "type": "battery", "key": "󱊢 Battery", "keyColor": "1;38;2;185;97;255" },
    { "type": "poweradapter", "key": "󰚥 Power Adapter", "keyColor": "1;38;2;190;90;255" }
  ]
}
